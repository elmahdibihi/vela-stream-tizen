<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://iptvstream.app/IPTVStream"
        version="4.4.0">
  <tizen:application id="IPTVStr001.main" package="IPTVStr001" required_version="5.0"/>
  <tizen:profile name="tv-samsung"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
  <tizen:content-security-policy>
    default-src * 'unsafe-inline' 'unsafe-eval' data: blob:;
    media-src * data: blob:;
  </tizen:content-security-policy>
  <access origin="*" subdomains="true"/>
  <content src="index.html"/>
  <name>Vela Stream</name>
  <icon src="icon-vela.png"/>
  <tizen:setting screen-orientation="landscape" background-support="disable"/>
</widget>
